  m_ActivationSlot: {fileID: 114350483966675083}
  m_BlockName: Expand and fade smoke
  m_HLSLCode: "void FadeSmoke(inout VFXAttributes attributes, in float Growth)\n{\n    float t = saturate(attributes.age / max(0.05, attributes.lifetime));\n    attributes.alpha *= smoothstep(0.0, 0.12, t) * (1.0 - smoothstep(0.5, 1.0, t));\n    attributes.size *= lerp(1.0, Growth, t);\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: FadeSmoke
    selectedIndex: 0
