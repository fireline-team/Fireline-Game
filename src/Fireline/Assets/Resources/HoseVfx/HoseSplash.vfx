  m_BlockName: Fade droplets
  m_HLSLCode: "void FadeHose(inout VFXAttributes attributes, in float4 EffectColor)\r\n{\r\n    float t = saturate(attributes.age / max(0.02, attributes.lifetime));\r\n    attributes.alpha = EffectColor.w * (1.0 - smoothstep(0.55, 1.0, t));\n}\n"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: FadeHose
    selectedIndex: 0
