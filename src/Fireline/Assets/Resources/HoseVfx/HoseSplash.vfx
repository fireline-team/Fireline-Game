  m_ActivationSlot: {fileID: 114350483966675026}
  m_BlockName: Initialize hose splash
  m_HLSLCode: "void InitializeHose(inout VFXAttributes attributes, in float3 Origin, in float3 Direction, in float3 Up, in float Range, in float Width, in float Lifetime, in float ParticleSize, in float4 EffectColor, in float Speed, in float Spread)\r\n{\r\n    float r = frac(sin((float(attributes.particleId) + 1.0) * 12.9898) * 43758.5453);\r\n    float s = frac(sin((float(attributes.particleId) + 2.0) * 78.233) * 23421.631);\r\n    float q = frac(sin((float(attributes.particleId) + 3.0) * 39.425) * 17834.345);\r\n    float3 forward = normalize(Direction + float3(0.00001, 0, 0));\r\n    float3 across = normalize(float3(-forward.y, forward.x, 0) + float3(0.00001, 0, 0));\r\n    attributes.position = Origin;\r\n    attributes.age = 0;\r\n    attributes.lifetime = max(0.02, Lifetime);\r\n    attributes.size = ParticleSize * lerp(0.7, 1.3, s);\r\n    attributes.scaleX = 1;\r\n    attributes.scaleY = 1;\r\n    attributes.scaleZ = 1;\r\n    attributes.color = EffectColor.xyz;\r\n    attributes.alpha = EffectColor.w;\r\n    attributes.velocity = forward * lerp(0.6, 2.3, q) * Speed + across * (r - 0.5) * Spread + Up * lerp(0.3, 1.0, s);\r\n    attributes.lifetime *= lerp(0.6, 1.0, s);\r\n    attributes.size *= 0.65;\r\n}\n"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: InitializeHose
    selectedIndex: 0
