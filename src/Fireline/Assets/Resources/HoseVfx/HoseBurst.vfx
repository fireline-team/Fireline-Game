  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966675107}
  m_BlockName: Launch one water spear
  m_HLSLCode: "void LaunchSpear(inout VFXAttributes attributes, in float3 Origin, in float3 Direction, in float3 Up, in float Range, in float Width, in float Lifetime, in float ParticleSize, in float Length, in float SpearWidth, in float4 EffectColor)\n{\n    float3 forward = normalize(Direction);\n    float shotLength = min(Length, max(0.001, Range));\n    attributes.position = Origin + forward * shotLength * 0.5;\n    attributes.velocity = forward * (max(0.001, Range - shotLength) / max(0.02, Lifetime));\n    attributes.age = 0;\n    attributes.lifetime = Lifetime;\n    attributes.size = 1;\n    attributes.scaleX = shotLength;\n    attributes.scaleY = SpearWidth;\n    attributes.scaleZ = 1;\n    attributes.color = EffectColor.xyz;\n    attributes.alpha = EffectColor.w;\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: LaunchSpear
    selectedIndex: 0
