  m_Script: {fileID: 11500000, guid: 833c3541f2af4b28b080abc2cd1a804d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Block.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 114350483966675071}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 114350483966675142}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966675143}
  m_BlockName: Align spear and fade its tail
  m_HLSLCode: "void AimSpear(inout VFXAttributes attributes, in float FadeStart)\n{\n    float3 forward = normalize(attributes.velocity);\n    attributes.axisY = normalize(cross(attributes.axisZ, forward));\n    attributes.axisX = forward;\n    attributes.axisZ = normalize(cross(attributes.axisX, attributes.axisY));\n    float t = saturate(attributes.age / max(0.02, attributes.lifetime));\n    attributes.alpha *= 1.0 - smoothstep(FadeStart, 1.0, t);\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: AimSpear
    selectedIndex: 0
