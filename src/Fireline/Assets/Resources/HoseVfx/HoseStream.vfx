  m_BlockName: Fade detached droplets
  m_HLSLCode: "void FadeDroplets(inout VFXAttributes attributes)\n{\n    float t = saturate(attributes.age / max(0.02, attributes.lifetime));\n    attributes.alpha *= 1.0 - smoothstep(0.35, 1.0, t);\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: FadeDroplets
    selectedIndex: 0
