  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966675508}
  m_BlockName: Follow muzzle and stop with trigger
  m_HLSLCode: "void WaterCore(inout VFXAttributes attributes, in float3 Origin, in float4 BeamColor, in float Active)\n{\n    attributes.position = Origin;\n    attributes.velocity = float3(0,0,0);\n    attributes.age = 0;\n    attributes.lifetime = 1;\n    attributes.size = 1;\n    attributes.scaleX = 1;\n    attributes.scaleY = 1;\n    attributes.scaleZ = 1;\n    attributes.axisX = float3(1,0,0);\n    attributes.axisY = float3(0,1,0);\n    attributes.axisZ = float3(0,0,1);\n    attributes.color = BeamColor.xyz;\n    attributes.alpha = BeamColor.w;\n    attributes.alive = Active > 0.5;\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: WaterCore
    selectedIndex: 0
