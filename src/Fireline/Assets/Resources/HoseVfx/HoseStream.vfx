  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966675025}
  m_BlockName: Initialize hose stream
  m_HLSLCode: "void InitializeHose(inout VFXAttributes attributes, in float3 Origin, in float3 Direction, in float3 Up, in float Range, in float Width, in float Lifetime, in float ParticleSize)\n{\n    float r = frac(sin((float(attributes.particleId) + 1.0) * 12.9898) * 43758.5453);\n    float s = frac(sin((float(attributes.particleId) + 2.0) * 78.233) * 23421.631);\n    float q = frac(sin((float(attributes.particleId) + 3.0) * 39.425) * 17834.345);\n    float3 forward = normalize(Direction + float3(0.00001, 0, 0));\n    float3 across = normalize(float3(-forward.y, forward.x, 0) + float3(0.00001, 0, 0));\n    attributes.position = Origin;\n    attributes.age = 0;\n    attributes.lifetime = max(0.02, Lifetime);\n    attributes.size = ParticleSize * lerp(0.7, 1.3, s);\n    attributes.scaleX = 1;\n    attributes.scaleY = 1;\n    attributes.scaleZ = 1;\n    attributes.color = float3(0.52, 0.82, 1.0);\n    attributes.alpha = 1;\n    attributes.velocity = forward * (Range / max(0.02, Lifetime)) + across * ((r - 0.5) * Width / max(0.02, Lifetime)) * 0.25;\n    attributes.position += across * (s - 0.5) * min(Width, 0.08);\n}\n"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: InitializeHose
    selectedIndex: 0
