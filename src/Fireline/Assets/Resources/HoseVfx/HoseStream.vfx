  m_ActivationSlot: {fileID: 114350483966675050}
  m_BlockName: Fade droplets
  m_HLSLCode: "void FadeHose(inout VFXAttributes attributes)\n{\n    float t = saturate(attributes.age / max(0.02, attributes.lifetime));\n    attributes.alpha = 0.85 * (1.0 - smoothstep(0.55, 1.0, t));\n}\n"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: FadeHose
    selectedIndex: 0
